{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",//Nodenext is not compataible with drizzle
    "moduleResolution": "Node",//Nodenext is not compataible with drizzle
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    // Stricter Typechecking Options
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, // Allows clean imports like: import express from "express"
    "forceConsistentCasingInFileNames": true, // Prevents file name case mismatch bugs (Linux vs Windows)
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src"
  ], // "tsc, compile only src/"
  "exclude": [
    "node_modules"
  ] // "tsc, ignore node_modules/"
}